# Copier en .env pour du développement local (jamais commité — voir .gitignore).
# En production (Scalingo), ces variables se règlent dans les "Variables
# d'environnement" de l'application — DATABASE_URL est fournie
# automatiquement par l'addon PostgreSQL Scalingo, pas besoin de la saisir.

PORT=3000
NODE_ENV=production

# Fournie automatiquement par Scalingo quand l'addon PostgreSQL est attaché.
# Format local de développement (sslmode=disable) :
DATABASE_URL=postgres://appa_dev:appa_dev_local@localhost:5432/appa_board_dev

# Domaine exact depuis lequel le board sera consulté, pour l'en-tête CORS —
# laisser vide tant que la page et l'API sont servies par le même domaine
# (cas normal ici : un seul serveur sert la page ET l'API).
ALLOWED_ORIGIN=
